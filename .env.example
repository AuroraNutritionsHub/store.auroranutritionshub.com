DB_HOST=localhost
DB_PORT=3306
DB_NAME=gym_store
DB_USER=root
DB_PASSWORD=

# Or a single connection string instead of the DB_* lines:
# DATABASE_URL=mysql://user:password@host:3306/database

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

DELIVERY_CHARGE=50

# Optional: where uploaded images are stored, relative to this folder (default: uploads)
# UPLOADS_PATH=uploads

# Optional: how long a Socket.IO long-poll waits before replying with a ping (default: 20)
# SOCKET_POLL_SECONDS=20
